{
  "name": "@obsidian-connect/plugin",
  "version": "0.7.19",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -p tsconfig.json && node esbuild.config.mjs production",
    "typecheck": "tsc -p tsconfig.json",
    "test:merge": "tsx scripts/merge-selftest.mts",
    "test:socket": "tsx --tsconfig scripts/tsconfig.json scripts/socket-selftest.mts",
    "test:sync": "tsx --tsconfig scripts/tsconfig.json scripts/binding-selftest.mts",
    "test:load": "node scripts/load-selftest.mjs",
    "test:vault": "tsx --tsconfig scripts/tsconfig.json scripts/vault-selftest.mts",
    "test:folders": "tsx --tsconfig scripts/tsconfig.json scripts/folder-selftest.mts",
    "test:recovery": "tsx --tsconfig scripts/tsconfig.json scripts/recovery-selftest.mts",
    "test:account": "tsx --tsconfig scripts/tsconfig.json scripts/account-selftest.mts",
    "test:backup": "tsx --tsconfig scripts/tsconfig.json scripts/backup-selftest.mts",
    "test:rollback": "tsx --tsconfig scripts/tsconfig.json scripts/rollback-selftest.mts"
  },
  "dependencies": {
    "@obsidian-connect/shared": "*",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-de": "^4.1.1",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "hash-wasm": "^4.12.0",
    "lib0": "^0.2.98",
    "qrcode-generator": "2.0.4",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@codemirror/commands": "6.6.2",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.7.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "obsidian": "latest",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3"
  }
}
