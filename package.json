{
  "name": "obsidian-connect",
  "version": "0.7.16",
  "private": true,
  "type": "module",
  "description": "End-to-end encrypted CRDT (Yjs) synchronization and live collaboration for Obsidian vaults.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:plugin": "npm run dev -w @obsidian-connect/plugin",
    "build:plugin": "npm run build -w @obsidian-connect/plugin",
    "dev:server": "npm run dev -w @obsidian-connect/server",
    "start:server": "npm run start -w @obsidian-connect/server",
    "start:backup": "npm run start -w @obsidian-connect/backup",
    "cli": "npm run cli -w @obsidian-connect/server --",
    "test:merge": "npm run test:merge -w @obsidian-connect/plugin",
    "test:load": "npm run test:load -w @obsidian-connect/plugin",
    "test:rooms": "npm run test:rooms -w @obsidian-connect/server",
    "test:sync": "npm run test:sync -w @obsidian-connect/plugin",
    "test:socket": "npm run test:socket -w @obsidian-connect/plugin",
    "test:vault": "npm run test:vault -w @obsidian-connect/plugin",
    "test:recovery": "npm run test:recovery -w @obsidian-connect/plugin",
    "test:account": "npm run test:account -w @obsidian-connect/plugin",
    "test:backup": "npm run test:backup -w @obsidian-connect/plugin",
    "test:rollback": "npm run test:rollback -w @obsidian-connect/plugin"
  },
  "overrides": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@codemirror/commands": "6.6.2"
  },
  "engines": {
    "node": ">=22"
  }
}
