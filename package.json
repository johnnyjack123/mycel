{
  "name": "mycel",
  "version": "0.9.29",
  "private": true,
  "type": "module",
  "description": "End-to-end encrypted CRDT (Yjs) synchronization and live collaboration for Obsidian vaults.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:plugin": "npm run dev -w @mycel/plugin",
    "build:plugin": "npm run build -w @mycel/plugin",
    "dev:server": "npm run dev -w @mycel/server",
    "start:server": "npm run start -w @mycel/server",
    "start:backup": "npm run start -w @mycel/backup",
    "cli": "npm run cli -w @mycel/server --",
    "test:merge": "npm run test:merge -w @mycel/plugin",
    "test:load": "npm run test:load -w @mycel/plugin",
    "test:rooms": "npm run test:rooms -w @mycel/server",
    "test:security": "npm run test:security -w @mycel/server && npm run test:security -w @mycel/plugin",
    "test:sync": "npm run test:sync -w @mycel/plugin",
    "test:socket": "npm run test:socket -w @mycel/plugin",
    "test:vault": "npm run test:vault -w @mycel/plugin",
    "test:folders": "npm run test:folders -w @mycel/plugin",
    "test:recovery": "npm run test:recovery -w @mycel/plugin",
    "test:account": "npm run test:account -w @mycel/plugin",
    "test:backup": "npm run test:backup -w @mycel/plugin",
    "test:rollback": "npm run test:rollback -w @mycel/plugin",
    "test:timemachine": "npm run test:timemachine -w @mycel/plugin",
    "test:replace": "npm run test:replace -w @mycel/plugin",
    "test:join": "npm run test:join -w @mycel/plugin",
    "bench": "npm run bench -w @mycel/plugin --"
  },
  "overrides": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@codemirror/commands": "6.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "AGPL-3.0-or-later"
}
