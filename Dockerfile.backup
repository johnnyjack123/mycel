# The Obsidian Connect backup server: pulls a vault from the sync server,
# decrypts it in memory and hands it to restic. CI builds and publishes it
# from main (the docker-backup job in .github/workflows/build.yml); by hand,
# from the repository root:
#
#   docker build -f Dockerfile.backup -t obsidian-connect-backup .
#   docker exec <container> obsidian-connect-backup invite <name>
FROM node:24-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
# Every workspace's manifest, or npm ci refuses the lockfile.
COPY packages/shared/package.json packages/shared/
COPY packages/server/package.json packages/server/
COPY packages/plugin/package.json packages/plugin/
COPY packages/backup/package.json packages/backup/
RUN npm ci --omit=dev --workspace @obsidian-connect/backup

# restic's own release, checked against its checksum: the version the tests run.
FROM alpine:3.22 AS restic
ARG RESTIC_VERSION=0.19.1
ARG TARGETARCH
RUN set -eu; \
    case "${TARGETARCH:-amd64}" in \
      amd64) sum=f415415624dcc452f2a02b8c33641791a8c6d6d3b65bbb3543fcf9a25151585c ;; \
      arm64) sum=a5f64aaab53d51e311fa3829124c5b703f2d14cf187d8640b6be3b2b49376465 ;; \
      *) echo "no restic release checked for ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    wget -q -O /restic.bz2 "https://github.com/restic/restic/releases/download/v${RESTIC_VERSION}/restic_${RESTIC_VERSION}_linux_${TARGETARCH:-amd64}.bz2"; \
    echo "${sum}  /restic.bz2" | sha256sum -c -; \
    bunzip2 /restic.bz2; \
    chmod +x /restic

# rclone's own release, checked against its checksum: restic reaches every cloud
# rclone knows through it (rclone:<remote>:<path>).
FROM alpine:3.22 AS rclone
ARG RCLONE_VERSION=1.75.1
ARG TARGETARCH
RUN set -eu; \
    case "${TARGETARCH:-amd64}" in \
      amd64) sum=982b5aa772841168f8e380f139e9e787b2a105403e32b94da8676a0e1c0a13ab ;; \
      arm64) sum=03f2504174034b6d004152ed7369251c9a9ec1f7e0836eda420f5c7a5ec0dff9 ;; \
      *) echo "no rclone release checked for ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    wget -q -O /rclone.zip "https://github.com/rclone/rclone/releases/download/v${RCLONE_VERSION}/rclone-v${RCLONE_VERSION}-linux-${TARGETARCH:-amd64}.zip"; \
    echo "${sum}  /rclone.zip" | sha256sum -c -; \
    unzip -q /rclone.zip -d /unpacked; \
    mv "/unpacked/rclone-v${RCLONE_VERSION}-linux-${TARGETARCH:-amd64}/rclone" /rclone; \
    chmod +x /rclone

FROM node:24-alpine
WORKDIR /app
# su-exec: the entrypoint hands the folders to the backup server's user, then runs it as that user.
# openssh-client: restic reaches an sftp: repository through ssh. ca-certificates: TLS to a cloud.
RUN apk add --no-cache su-exec openssh-client ca-certificates
# rclone's remotes live in the data folder: they survive an update, and rclone can
# write back a refreshed token.
ENV NODE_ENV=production \
    OBSIDIAN_CONNECT_BACKUP_DATA=/data \
    OBSIDIAN_CONNECT_BACKUP_ENCRYPTED=/encrypted \
    OBSIDIAN_CONNECT_BACKUP_DECRYPTED=/decrypted \
    OBSIDIAN_CONNECT_BACKUP_WORK=/run/obsidian-connect-backup \
    OBSIDIAN_CONNECT_RESTIC=/usr/local/bin/restic \
    RCLONE_CONFIG=/data/rclone/rclone.conf \
    RCLONE_CACHE_DIR=/data/rclone/cache \
    OBSIDIAN_CONNECT_OWN="/data /data/rclone" \
    OBSIDIAN_CONNECT_OWN_TOP="/encrypted /decrypted /run/obsidian-connect-backup"
COPY --from=restic /restic /usr/local/bin/restic
COPY --from=rclone /rclone /usr/local/lib/rclone/rclone
COPY docker/rclone.sh /usr/local/bin/rclone
COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/shared/src packages/shared/src
COPY packages/backup/package.json packages/backup/
COPY packages/backup/src packages/backup/src
COPY packages/backup/bin packages/backup/bin
COPY docker/entrypoint.sh /usr/local/bin/obsidian-connect-entrypoint
RUN chmod +x packages/backup/bin/obsidian-connect-backup.mjs /usr/local/bin/obsidian-connect-entrypoint /usr/local/bin/rclone \
 && ln -s /app/packages/backup/bin/obsidian-connect-backup.mjs /usr/local/bin/obsidian-connect-backup \
 && mkdir -p /data /encrypted /decrypted /run/obsidian-connect-backup \
 && chown node:node /data /encrypted /decrypted /run/obsidian-connect-backup
# No USER: the entrypoint starts as root, hands the folders over and drops to
# PUID:PGID (1000:1000, the image's node user) before the backup server runs.
VOLUME /data
ENTRYPOINT ["/usr/local/bin/obsidian-connect-entrypoint"]
CMD ["node", "--import", "tsx", "packages/backup/src/index.ts"]
