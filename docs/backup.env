# Copy to `.env` next to docker-compose.backup.yml on the machine the backup
# server runs on; see docs/BACKUP.md.

# The sync server, as your devices are given it. The backup server only ever
# connects outward, to this address: it needs no port of its own. On the same
# host as the sync server, the public address often does not work from inside a
# container: give the one it reaches directly, e.g. ws://192.168.1.10:1234 -
# ws://, not wss://: the sync server speaks no TLS on its own port.
OBSIDIAN_CONNECT_SERVER=wss://sync.example.com

# What your devices are shown this backup server as.
OBSIDIAN_CONNECT_BACKUP_NAME=NAS

# The host folder every local destination lies below, mounted at /backup in
# the container. It must be writable by user 1000 (`chown -R 1000:1000`). A
# cloud folder mounted on the host (rclone mount, WebDAV, ...) may lie in it.
BACKUP_FOLDER=/srv/obsidian-backups

# The RAM disk a vault's notes lie in, decrypted, during a backup. It has to
# hold every note and canvas of the largest vault backed up here, plus its
# trash; pictures and other files do not go there.
RAM_DISK=1g
