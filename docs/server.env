# Copy to `.env` in the repository root, or next to docker-compose.yml on a
# server. Read by `docker compose`, and by `npm run start:server` and
# `npm run cli` when the server runs without Docker. Variables set in the
# shell win over this file.

# Signs access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Unset, the server falls back to a built-in secret and warns - fine on a
# laptop, never on a reachable server. Docker compose refuses to start without it.
OBSIDIAN_CONNECT_JWT_SECRET=

# invite: accounts only with a code from `obsidian-connect invite`, which the
#         person enters when creating the account. A code works once.
# open:   anyone who reaches the server can create an account.
OBSIDIAN_CONNECT_REGISTRATION=invite

# How long a device stays signed in without being used, in seconds (30 days).
OBSIDIAN_CONNECT_TOKEN_TTL=2592000

# A log line per document frame. Noisy.
OBSIDIAN_CONNECT_LOG_UPDATES=false

# The largest attachment (image, PDF, ...) the server takes, in MB. Larger
# files stay on the device they are on.
OBSIDIAN_CONNECT_MAX_FILE_MB=100

# How much one account may store in attachments, in MB. Unset: no limit.
# Worth setting with open registration, so a stranger cannot fill the disk.
# OBSIDIAN_CONNECT_QUOTA_MB=

# Published port (Docker), or the port the server listens on (npm).
PORT=1234
