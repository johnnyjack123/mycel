# Copy to .env next to docker-compose.yml and fill in.

# Signs access tokens. Generate one with: openssl rand -base64 48
OBSIDIAN_CONNECT_JWT_SECRET=replace-me

# invite: accounts only come from `obsidian-connect user add <name>` inside the
#         container, which prints a code the person enters when creating the account.
# open:   anyone who reaches the server can create an account.
OBSIDIAN_CONNECT_REGISTRATION=invite

# How long a device stays signed in without being used, in seconds (30 days).
OBSIDIAN_CONNECT_TOKEN_TTL=2592000

# A log line per document frame. Noisy.
OBSIDIAN_CONNECT_LOG_UPDATES=false

# Published port.
PORT=1234
